{
  "permissions": {
    "allow": [
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git checkout -b v2/hadi/*)",
      "Bash(git checkout v2/hadi/*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git commit:*)",
      "Bash(git push origin v2/hadi/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr view:*)",
      "Bash(rg:*)",
      "Bash(cat .pipeline/*)",
      "Bash(.pipeline/adapters/*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git merge:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guardrail-pretooluse.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/report-stop.sh"
          }
        ]
      }
    ]
  }
}
